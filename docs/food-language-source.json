  "transforms": [
    "Pass uiLanguage() to existing source components at construction and render time.",
    "Use explicit semantic source keys and handwritten cloud control translations; never use user text as translation keys.",
    "Re-export the shared language owner from recipe-source/ui-language.js.",
    "Adapt the source nutrition-label presenter imports without formula changes.",
    "Format serialized canonical nutritionLabel/vitaminActivity error tags; never parse server English sentences.",
    "Keep editor menu action identities separate from translated button labels.",
    "Preserve user food names, portion labels, notes, source records, canonical quantities, and receipt payloads.",
    "Pass the selected language to BarcodeScanner and translate cloud branded search/review controls, preserving provider identity and original product/portion/source text."
  ],
  "validation": [
    "tests/food-language-browser.test.mjs: French, German and Brazilian Portuguese library create/review/cancel, zero and missing values, committed503 exact retry, draft disposal, 320px layout, complete cloud keys/placeholders and tagged errors.",
    "Existing English browser workflows: custom food, meal, recipe, retirement, photo log, text log, food entry/copy, favorites/sharing, suggestions, Oracle, repeats, recipe import.",
    "tests/barcode-language-browser.test.mjs: English and French source scanner/manual lookup, branded search/no results, nutrition review, source names/portion labels and barcode.log command; real camera permission and provider network are stubbed."
  ],
  "limits": [
    "User-authored and imported food names, descriptions, portion labels and AI observations remain their original text.",
    "Browser-native validation and file picker wording follow the browser locale.",
    "Production hosted verification and full-suite release checks are handled by the parent task."
  ]
}
