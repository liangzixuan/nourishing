APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6abac02e002f10c31ac2
PUBLIC_ORIGIN=https://nourishing-cloud.appwrite.network
PORT=4291
HOST=127.0.0.1
# Local integration only. Cloud Sites supplies its scoped ephemeral request key.
APPWRITE_API_KEY=

# Server-only photo recognition. Never include these in public assets.
GEMINI_API_KEY=
PHOTO_REVIEW_SECRET=

# Enable after deploying the private scheduler and granting execution scopes.
SCHEDULER_ENABLED=false

# Persistent server-only Web Push signing keys. Do not rotate during deployments.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Optional server-only Sentry DSN for 5xx and background Function error alerts.
SENTRY_DSN=
